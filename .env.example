# Database
POSTGRES_DB=portfolio_db
POSTGRES_USER=portfolio_user
POSTGRES_PASSWORD=portfolio_password

# Backend
DJANGO_SECRET_KEY=development-secret-key-change-in-production
DATABASE_URL=postgresql://portfolio_user:portfolio_password@localhost:5432/portfolio_db
FRONTEND_BASE_URL=http://localhost:5173
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Frontend
VITE_API_URL=http://localhost:8000/api/v1

# CoinGecko cryptocurrency provider
COINGECKO_API_KEY=YOUR_DEVELOPMENT_API_KEY
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
COINGECKO_ENABLED=True
COINGECKO_REQUEST_TIMEOUT=20
COINGECKO_PRICE_SYNC_INTERVAL_MINUTES=15
COINGECKO_HISTORY_SYNC_ENABLED=True
COINGECKO_QUOTE_CURRENCY=INR

# MFAPI Indian mutual funds provider
MFAPI_BASE_URL=https://api.mfapi.in
MFAPI_ENABLED=True
MFAPI_REQUEST_TIMEOUT=20
MF_NAV_SYNC_ENABLED=True
MF_NAV_SYNC_INTERVAL_HOURS=24
MF_NAV_DEFAULT_CURRENCY=INR

