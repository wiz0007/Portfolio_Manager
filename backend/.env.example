# Application
APP_ENV=development
DEBUG=True
SECRET_KEY=django-insecure-dev-key-change-me-portfolio-manager-sprint1

# Database (PostgreSQL in production/docker; SQLite default fallback in local dev without PostgreSQL)
DATABASE_URL=postgres://portfolio_user:portfolio_password@localhost:5432/portfolio_db

# Security & Allowed Origins
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Cookie Security (Set to True in HTTPS production)
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Background Jobs (Reserved for Post-Sprint 1)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
