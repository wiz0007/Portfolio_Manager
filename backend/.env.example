# Application
APP_ENV=development
DEBUG=True
SECRET_KEY=django-insecure-dev-key-change-me-portfolio-manager-sprint1

# Database (Neon PostgreSQL / PostgreSQL connection URL)
DATABASE_URL=postgresql://main_dev:your_password@ep-lively-wave-b38we4re.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Security & Allowed Origins
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Cookie Security (Set to True in HTTPS production)
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Email & Verification
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@portfoliomanager.local
FRONTEND_BASE_URL=http://localhost:5173
EMAIL_VERIFICATION_TIMEOUT=1800

# Background Jobs (Reserved for Post-Sprint 1)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
